# SAND5G N2 rules — Snort 3
#
# Monitoring point: N2 interface (AMF ↔ gNB)
#   Protocol: NGAP / SCTP / port 38412  (3GPP TS 38.412)
#
# Interface defaults (set via env):
#   lo    — single-VM: Open5GS NFs bind 127.0.0.x, UERANSIM on same host
#   cni0  — k3s flannel pod networking (N2_IF=cni0)
#
# Snort 3.9.1.0 compatibility notes:
#   - sctp_chunk_type: NOT available (no SCTP IPS plugin compiled in).
#   - offset:/depth: standalone keywords do NOT exist in Snort 3.
#   - All positional matching uses byte_test with explicit offsets.
#   - Offsets are from the start of the IP payload (= SCTP packet):
#       [0-1]  src port    [2-3]  dst port
#       [4-7]  vtag        [8-11] checksum
#       [12]   chunk type  [13]   chunk flags  [14-15] chunk length
#   - Do NOT use flow: (no stream_sctp inspector in Snort 3).
#
# SCTP chunk type byte values (RFC 4960):
#   DATA=0  INIT=1  INIT_ACK=2  SACK=3  HEARTBEAT=4
#   ABORT=6  SHUTDOWN=7  COOKIE_ECHO=10

# ── Section 1: SCTP chunk-level anomalies ────────────────────────────────────

# INIT storm — AMF association flood  (chunk type 1 = INIT)
alert ip any any -> any 38412 (
    msg:"SAND5G N2-001 SCTP INIT flood to AMF — N2 association storm";
    ip_proto:132;
    byte_test:1,=,1,12;
    detection_filter: track by_src, count 30, seconds 1;
    classtype:attempted-dos;
    metadata: mitre_tactic "Impact", mitre_technique_id "T1499";
    sid:9000001; rev:4;)

# COOKIE-ECHO storm — handshake replay / amplification  (chunk type 10 = COOKIE_ECHO)
alert ip any any -> any 38412 (
    msg:"SAND5G N2-002 SCTP COOKIE-ECHO storm — 3WHS abuse";
    ip_proto:132;
    byte_test:1,=,10,12;
    detection_filter: track by_src, count 60, seconds 2;
    classtype:attempted-dos;
    metadata: mitre_tactic "Impact", mitre_technique_id "T1499";
    sid:9000002; rev:4;)

# ABORT flood — forced teardown of live NGAP associations  (chunk type 6 = ABORT)
alert ip any any -> any 38412 (
    msg:"SAND5G N2-003 SCTP ABORT flood — forced N2 teardown";
    ip_proto:132;
    byte_test:1,=,6,12;
    detection_filter: track by_src, count 10, seconds 2;
    classtype:attempted-dos;
    metadata: mitre_tactic "Impact", mitre_technique_id "T1499";
    sid:9000003; rev:4;)

# HEARTBEAT flood — keepalive abuse / state exhaustion  (chunk type 4 = HEARTBEAT)
alert ip any any -> any 38412 (
    msg:"SAND5G N2-004 SCTP HEARTBEAT flood to AMF";
    ip_proto:132;
    byte_test:1,=,4,12;
    detection_filter: track by_src, count 50, seconds 2;
    classtype:attempted-dos;
    metadata: mitre_tactic "Impact", mitre_technique_id "T1499";
    sid:9000004; rev:4;)

# SHUTDOWN storm — session termination flood  (chunk type 7 = SHUTDOWN)
alert ip any any -> any 38412 (
    msg:"SAND5G N2-005 SCTP SHUTDOWN flood to AMF";
    ip_proto:132;
    byte_test:1,=,7,12;
    detection_filter: track by_src, count 20, seconds 2;
    classtype:attempted-dos;
    metadata: mitre_tactic "Impact", mitre_technique_id "T1499";
    sid:9000005; rev:4;)

# Verification tag = 0 on non-INIT chunk (SCTP spec violation)
# vtag must be zero only on INIT; any other chunk type with vtag=0 is malformed.
alert ip any any -> any 38412 (
    msg:"SAND5G N2-006 SCTP vtag=0 on non-INIT — malformed / crafted packet";
    ip_proto:132;
    byte_test:4,=,0,4,big;
    byte_test:1,!=,1,12;
    classtype:bad-unknown;
    metadata: mitre_tactic "Evasion", mitre_technique_id "T1599";
    sid:9000006; rev:4;)

# Chunk length < 4 bytes — minimum valid chunk is 4 bytes (type+flags+len)
alert ip any any -> any 38412 (
    msg:"SAND5G N2-007 SCTP chunk length < 4 — fuzzing or malformed packet";
    ip_proto:132;
    byte_test:2,<,4,14,big;
    classtype:bad-unknown;
    metadata: mitre_tactic "Impact", mitre_technique_id "T1499";
    sid:9000007; rev:2;)

# SCTP INIT to AMF from unexpected source  (chunk type 1 = INIT)
alert ip any any -> any 38412 (
    msg:"SAND5G N2-008 SCTP INIT to AMF from unexpected source";
    ip_proto:132;
    byte_test:1,=,1,12;
    classtype:attempted-recon;
    metadata: mitre_tactic "Initial Access", mitre_technique_id "T1078";
    sid:9000008; rev:3;)

# High DATA chunk rate — NGAP message storm / fuzzing  (chunk type 0 = DATA)
alert ip any any -> any 38412 (
    msg:"SAND5G N2-009 SCTP DATA storm to AMF — NGAP message flood";
    ip_proto:132;
    byte_test:1,=,0,12;
    detection_filter: track by_src, count 500, seconds 1;
    classtype:attempted-dos;
    metadata: mitre_tactic "Impact", mitre_technique_id "T1499";
    sid:9000009; rev:3;)

# SCTP INIT on loopback from AMF itself (back-to-self — anomalous)  (chunk type 1 = INIT)
alert ip 127.0.0.0/8 any -> 127.0.0.0/8 38412 (
    msg:"SAND5G N2-010 SCTP INIT on loopback — unexpected gNB source IP";
    ip_proto:132;
    byte_test:1,=,1,12;
    detection_filter: track by_src, count 5, seconds 10;
    classtype:attempted-recon;
    metadata: mitre_tactic "Discovery", mitre_technique_id "T1046";
    sid:9000010; rev:3;)
